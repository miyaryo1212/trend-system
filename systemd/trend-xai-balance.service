[Unit]
Description=Check xAI prepaid credit balance and alert to Slack
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__SYSTEM_DIR__
EnvironmentFile=__HOME__/.env.agent
Environment="PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/snap/bin"
ExecStart=__SYSTEM_DIR__/scripts/check-xai-balance.sh
StandardOutput=append:__SYSTEM_DIR__/logs/xai-balance.log
StandardError=append:__SYSTEM_DIR__/logs/xai-balance.log
TimeoutStartSec=120
